[node name="InfoText" type="Label" parent="InfoPanel/VBoxContainer"]
layout_mode = 2
text = "Ball Fight Game

A physics-based rolling-ball arena shooter.
Roll around, pick up weapons, and fight waves of enemy balls!

Controls:
WASD - Move | Shift - Sprint | Space - Jump
Mouse - Look/Aim | Click - Fire | R - Reload
Q - Pick up weapon | G - Grenade | F - Flashlight
P/Esc - Pause | X - Return to menu"
horizontal_alignment = 1
autowrap_mode = 2

